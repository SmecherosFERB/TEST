# Toate sunt opționale. Fără o cheie, componenta respectivă lipsește și analiza continuă.

# Claude: a doua opinie la semnalele neclare (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Prețuri zilnice cu istoric lung, gratuit 800 cereri/zi (https://twelvedata.com).
TWELVE_DATA_API_KEY=

# Știri cu sentiment, rezultate trimestriale, insideri; gratuit 25 cereri/zi
# (https://www.alphavantage.co/support/#api-key).
ALPHA_VANTAGE_API_KEY=

# SEC EDGAR, tranzacțiile oficiale ale insiderilor: fără cheie, dar SEC cere nume și email.
SEC_USER_AGENT="StockAI numele-tau@exemplu.ro"

# FRED, date macro: merge și fără cheie; cu cheie gratuită e mai stabil
# (https://fred.stlouisfed.org/docs/api/api_key.html).
FRED_API_KEY=

# Modelul Claude folosit și cât de mult „gândește” (low/medium/high/xhigh/max).
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
