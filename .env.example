# Cheia pentru Claude API (https://console.anthropic.com). Fără ea, platforma
# rulează doar pe reguli și nu cere a doua opinie.
ANTHROPIC_API_KEY=

# Opțional: sentiment din știri (https://www.alphavantage.co/support/#api-key).
ALPHA_VANTAGE_API_KEY=

# Opțional: modelul Claude folosit și cât de mult „gândește” (low/medium/high/xhigh/max).
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
